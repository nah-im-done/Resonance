---
---

<header class="site-header">
  <a
    class="logo-link"
    href="/"
    aria-label="Resonance home"
  >
    <img
      src="/images/landing/Logo.png"
      alt="Resonance"
    />
  </a>

  <a
    class="instagram-link"
    href="https://www.instagram.com/resonance.exhibition/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instagram"
  >
    <img
      src="/images/landing/Insta_icon.png"
      alt=""
    />
  </a>
</header>

<style>
  .site-header {
    position: fixed;

    top: 0;
    left: 0;
    right: 0;

    z-index: 1000;

    height: 70px;

    background: #000;

    border-bottom: 2px solid #fff;
  }

  .logo-link {
    position: absolute;

    top: 14px;
    left: 20px;

    display: block;

    width: 44.92px;
    height: 42px;

    text-decoration: none;
  }

  .logo-link img {
    display: block;

    width: 44.92px;
    height: 42px;

    max-width: none;
  }

  .instagram-link {
    position: absolute;

    top: 13.85px;
    right: 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 32px;
    height: 42.6px;

    text-decoration: none;
  }

  .instagram-link img {
    display: block;

    width: 20.3px;
    height: 20.3px;

    max-width: none;
  }
</style>