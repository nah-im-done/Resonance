<style>
.hero {
  padding: 0 0 32px;
}

.logo-image {
  width: 100%;
  aspect-ratio: 0.9;

  margin-bottom: 24px;

  overflow: hidden;
  position: relative;
}

.logo-image img {
  display: block;
  width: 100%;
  height: auto;

  transform: translateY(-12%);
}

.description {
  max-width: 100%;
  margin: 0;

  font-size: 16px;
  line-height: 1.45;
  letter-spacing: -0.01em;
}

@media (min-width: 1024px) {
  .logo-image {
    aspect-ratio: 1.06;
  }

  .logo-image img {
    transform: translateY(-19%);
  }

  .description {
    max-width: 640px;
  }
}
  .students {
    padding: 0 0 32px;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .section-header h2 {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
  }

  .section-header a {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 92px;
    min-height: 37px;

    padding: 4px 10px;

    border: 1px solid #fff;
    border-radius: 999px;

    font-size: 12px;
    text-decoration: none;

    flex-shrink: 0;
  }

  .student-wordmarks {
  display: grid;

  grid-template-columns: repeat(2, minmax(0, 1fr));

  column-gap: 16px;
  row-gap: 16px;

  align-items: center;
}

.student-wordmark {
  display: flex;
  align-items: center;
  justify-content: center;

  min-width: 0;
  min-height: 72px;

  padding: 4px;

  text-decoration: none;
}

.student-wordmark img {
  display: block;

  width: 100%;
  max-width: 180px;
  height: auto;

  object-fit: contain;
}

  .student-wordmark:hover {
    opacity: 0.8;
  }

@media (min-width: 768px) {
  .hero {
    padding-top: 48px;
  }

  .description {
    max-width: 640px;
  }

  .student-wordmarks {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 32px;
  }

  .student-wordmark {
    min-height: 100px;
  }

  .student-wordmark img {
    max-width: 220px;
  }
}
</style>